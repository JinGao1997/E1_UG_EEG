############################################
# 6) results/: ignore outputs but keep scripts
############################################
# 忽略 results 下的所有文件
results/*
results/**/*

# 重新放行 results 下的所有“文件夹目录”（让 Git 可以遍历进去）
!results/**/

# 重新放行脚本与配置文件
!results/**/*.py
!results/**/*.R
!results/**/*.r
!results/**/*.Rmd
!results/**/*.qmd
!results/**/*.m
!results/**/*.jl
!results/**/*.sh
!results/**/*.bash
!results/**/*.zsh
!results/**/*.ps1
!results/**/*.js
!results/**/*.ts
!results/**/*.json
!results/**/*.yaml
!results/**/*.yml
!results/**/*.toml
!results/**/*.ini
!results/**/*.cfg
!results/**/*.txt
!results/**/*.md
!results/**/*.ipynb

# 再次明确屏蔽 results 内的产出文件（防止上面某条规则误伤）
results/**/*.png
results/**/*.jpg
results/**/*.jpeg
results/**/*.tif
results/**/*.tiff
results/**/*.pdf
results/**/*.svg
results/**/*.eps
results/**/*.xlsx
results/**/*.xls
results/**/*.xlsm
results/**/*.csv
results/**/*.tsv
results/**/*.set
results/**/*.fdt
results/**/*.edf
results/**/*.bdf
results/**/*.vhdr
results/**/*.vmrk
results/**/*.eeg
results/**/*.cnt
results/**/*.mff
results/**/*.fif
results/**/*.ds
results/**/*.xdf
results/**/*.mat

# 明确屏蔽特定出版物文件夹
results/Behavioral/Pub_Output_Final/

