############################################
# 3) Data / raw / processed directories (common)
# (Keep raw data out of git)
############################################
data/
Data/
raw/
Raw/
processed/
Processed/

############################################
# 4) EEG / neuro specific (keep raw/processed files out of git)
############################################
# EEGLAB / BrainVision / common EEG formats
*.set
*.fdt
*.edf
*.bdf
*.vhdr
*.vmrk
*.eeg
*.cnt
*.mff
*.fif
*.ds
*.xdf

# MATLAB data (often huge)
*.mat

############################################
# 5) Your local-only folders (important for your repo)
############################################
Problematic_data/
_LOCAL_ONLY_BACKUP/

############################################
# 6) results/: ignore outputs but keep scripts
############################################
# Ignore everything under results by default...
results/**

# ...then re-allow directories so the "un-ignore" rules can match files inside them
!results/**/

# Re-allow scripts + configs inside results
!results/**/*.py
!results/**/*.R
!results/**/*.r
!results/**/*.Rmd
!results/**/*.qmd
!results/**/*.m
!results/**/*.jl
!results/**/*.sh
!results/**/*.bash
!results/**/*.zsh
!results/**/*.ps1
!results/**/*.js
!results/**/*.ts
!results/**/*.json
!results/**/*.yaml
!results/**/*.yml
!results/**/*.toml
!results/**/*.ini
!results/**/*.cfg
!results/**/*.txt
!results/**/*.md

# (Optional) allow notebooks if you consider them "scripts"
!results/**/*.ipynb

# But still ignore typical outputs/data under results (even if above rules exist elsewhere)
results/**/*.png
results/**/*.jpg
results/**/*.jpeg
results/**/*.tif
results/**/*.tiff
results/**/*.pdf
results/**/*.svg
results/**/*.eps
results/**/*.xlsx
results/**/*.xls
results/**/*.xlsm
results/**/*.csv
results/**/*.tsv

# Also ignore EEG/raw data formats under results (just in case)
results/**/*.set
results/**/*.fdt
results/**/*.edf
results/**/*.bdf
results/**/*.vhdr
results/**/*.vmrk
results/**/*.eeg
results/**/*.cnt
results/**/*.mff
results/**/*.fif
results/**/*.ds
results/**/*.xdf
results/**/*.mat

# Explicitly ignore your publication output folder (safe guard)
results/Behavioral/Pub_Output_Final/

############################################
# 7) Typical output folders elsewhere (optional)
############################################
Results/
Output/
Export/
Figures/
Plots/
Reports/
logs/
log/

############################################
# 8) Keep small templates/examples (if you use them)
############################################
!data_example/
!data_example/**

############################################
# 9) Keep key project files (usually tracked anyway)
############################################
!README.md
!LICENSE
!requirements.txt
!environment.yml
!.gitignore
